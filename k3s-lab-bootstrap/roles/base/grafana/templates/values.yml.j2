---
adminPassword: {{ grafana_admin_password }}

extraInitContainers: []
{% if grafana_local_ca_trust_enabled | bool %}
# Local-CA lane: publish + mount dmf-local-ca so Grafana's Go OAuth client
# trusts the Authentik public-host cert during server-side token/userinfo
# exchange. Mount the single ca.crt key via subPath so the existing
# /etc/ssl/certs directory in the Alpine image is preserved. SSL_CERT_FILE is
# the image-agnostic primary (Alpine's Go cert-dir scan is not guaranteed to
# pick up an extra file vs Debian/Zot).
extraConfigmapMounts:
  - name: dmf-local-ca
    mountPath: {{ grafana_local_ca_mount_path | to_json }}
    subPath: ca.crt
    configMap: {{ grafana_local_ca_configmap | to_json }}
    readOnly: true
env:
  SSL_CERT_FILE: {{ grafana_local_ca_mount_path | to_json }}
{% endif %}
extraVolumes: []
{% if grafana_oidc_enabled | bool %}
envFromSecret: {{ grafana_oidc_secret_name | to_json }}
{% endif %}

deploymentStrategy:
  type: Recreate

# umbrella #276: measured request honesty (2026-07-24 sample archive);
# requests-only, no limits.
resources:
{{ grafana_resources | to_nice_yaml(indent=2) | indent(2, true) }}

persistence:
  enabled: true
  size: {{ grafana_storage_size }}
  storageClassName: {{ grafana_storage_class }}

{% if grafana_exposure | default('host') == 'path' %}
grafana.ini:
  server:
    root_url: "%(protocol)s://%(domain)s{{ grafana_path }}"
    serve_from_sub_path: true
  # The verdict pane IS the front door (Amendment A §3).
  dashboards:
    default_home_dashboard_path: /var/lib/grafana/dashboards/dmf/dmf-are-we-ok.json
{% else %}
grafana.ini:
  server:
    root_url: "https://{{ grafana_host }}/"
    serve_from_sub_path: false
  # The verdict pane IS the front door (Amendment A §3).
  dashboards:
    default_home_dashboard_path: /var/lib/grafana/dashboards/dmf/dmf-are-we-ok.json
{% endif %}

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
      - name: Prometheus
        type: prometheus
        url: http://prometheus-server.{{ grafana_namespace }}.svc.cluster.local/prometheus
        access: proxy
        isDefault: true
      - name: Loki
        type: loki
        url: http://loki-gateway.{{ grafana_namespace }}.svc.cluster.local
        access: proxy

# Dashboard providers (dmfdeploy/dmfdeploy#166 WP-G / Amendment A): the chart
# keys external-ConfigMap dashboards PER PROVIDER (dashboardsConfigMaps.<name>
# mounted at /var/lib/grafana/dashboards/<name>) — two provider/ConfigMap
# pairs, no sidecar. `foldersFromFilesStructure` is a sidecar-provider knob
# and does NOT work with direct ConfigMap mounts (no subdirectories).
#   dmf    — folder "DMF": the operator's default surface ("Are we OK?",
#            "Platform services"; operator vocabulary per UX-Const. Art. 3).
#   system — folder "System": expert tier (demoted dotdc k8s views).
dashboardProviders:
  dashboardproviders.yaml:
    apiVersion: 1
    providers:
      - name: dmf
        orgId: 1
        folder: DMF
        type: file
        disableDeletion: false
        editable: true
        options:
          path: /var/lib/grafana/dashboards/dmf
      - name: system
        orgId: 1
        folder: System
        type: file
        disableDeletion: false
        editable: true
        options:
          path: /var/lib/grafana/dashboards/system

dashboardsConfigMaps:
  dmf: grafana-dmf-dashboards
  system: grafana-system-dashboards

# Dashboards from https://github.com/dotdc/grafana-dashboards-kubernetes
# Adapted for single-cluster k3s environment
