---
# umbrella #313: scrape promtail's own /metrics — the container:promtail_
# log_{lines,bytes}_per_second:rate1m recording rules (roles/base/prometheus/
# files/rules/recording.yaml) and the mandatory PromtailLogLimitDropping
# alert depend on this. Picked up by the existing kubernetes-pods scrape job
# (annotation-based discovery already in place; no new scrape job needed).
# port=3101 is the chart's own http-listen-port default.
podAnnotations:
  prometheus.io/scrape: "true"
  prometheus.io/port: "3101"
  prometheus.io/path: /metrics

config:
  clients:
    - url: {{ promtail_loki_url }}
  # Scrape the k3s API server audit log on each control-plane node so the
  # forensic trail lands in Loki alongside app logs. The k3s server writes
  # the audit log on the host filesystem at /var/log/kubernetes/audit.log
  # (configured in roles/base/k3s/templates/k3s-audit-logging.conf.j2).
  #
  # The `job: k3s-audit` label triggers the security-stream retention rule
  # in roles/stack/operator/loki/templates/values.yml.j2
  # (loki_security_retention, default 4380h / ~6 months). The Loki
  # compactor *deletes* entries past that retention window — it does not
  # archive them. The host-file copy goes to a separate WORM S3 path via
  # the audit-log-archival role (see roles/base/audit-log-archival).
  #
  # NOTE the __path__ glob: k3s rotates by lumberjack semantics so older
  # files appear as audit-YYYY-MM-DDTHH-MM-SS.SSS.log next to audit.log.
  # Scraping both means Promtail doesn't lose lines that rotated between
  # scrape ticks; positions.yaml de-dupes by inode.
  snippets:
    extraScrapeConfigs: |
      - job_name: k3s-audit
        static_configs:
          - targets:
              - localhost
            labels:
              job: k3s-audit
              host: ${HOSTNAME}
              __path__: /var/log/kubernetes/audit*.log
    # umbrella #313: node-protection guard — caps promtail's own outbound
    # push rate PER POD (by_label_name: pod; NOT container — container
    # names like "status" collide across the mxl viewer AND source's own
    # status sidecars, which would rate-limit them as one shared bucket).
    # drop: true is a deliberate, non-tunable decision (only rate/burst/
    # label are operator vars) — buffering instead of dropping just moves
    # the burst into promtail's own memory, and this is exactly why the
    # PromtailLogLimitDropping alert (roles/base/prometheus/templates/
    # rules/alerts.yaml.j2) is mandatory, not optional: a silent limiter
    # here would have hidden #308's own signal instead of surfacing it.
    #
    # Setting pipelineStages at all REPLACES the chart's own default
    # pipeline, so `- cri: {}` must stay first: k3s/containerd log lines
    # need CRI-format parsing (real timestamp + stream + content) before
    # anything downstream — including this limit stage — can reason about
    # them.
{% if promtail_log_line_limit_enabled | bool %}
    pipelineStages:
      - cri: {}
      - limit:
          rate: {{ promtail_log_line_limit_rate }}
          burst: {{ promtail_log_line_limit_burst }}
          by_label_name: {{ promtail_log_line_limit_label }}
          drop: true
{% endif %}

# Explicit hostPath mount for /var/log/kubernetes — the upstream chart's
# default mount of /var/log is enough today, but declaring the narrower
# mount keeps the audit pipeline working even if upstream tightens defaults.
# Read-only because Promtail must not write to the audit log directory.
extraVolumes:
  - name: var-log-kubernetes
    hostPath:
      path: /var/log/kubernetes
      type: DirectoryOrCreate
extraVolumeMounts:
  - name: var-log-kubernetes
    mountPath: /var/log/kubernetes
    readOnly: true

# Tolerate all node taints so Promtail scrapes every control-plane node;
# k3s control-plane nodes inherit the NoSchedule taint until the cloud CCM
# clears it, and the audit log lives on every server node.
tolerations:
  - effect: NoSchedule
    operator: Exists
  - effect: NoExecute
    operator: Exists

# Enable env-var expansion in the rendered config so the `host: ${HOSTNAME}`
# label in extraScrapeConfigs resolves to the actual node hostname at
# Promtail start time. Without -config.expand-env=true, Promtail reads
# `${HOSTNAME}` as a literal string per Grafana docs.
extraArgs:
  - -config.expand-env=true

# umbrella #276: measured request honesty (2026-07-24 sample archive);
# requests-only, no limits — see promtail_resources' own comment in
# defaults/main.yml for the launch-episode-burst rationale.
resources:
{{ promtail_resources | to_nice_yaml(indent=2) | indent(2, true) }}
