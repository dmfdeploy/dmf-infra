---
fullnameOverride: {{ blackbox_fullname_override }}

config:
  modules:
{{ blackbox_modules | to_nice_yaml(indent=4) | indent(4, true) }}

resources:
{{ blackbox_resources | to_nice_yaml(indent=2) | indent(2, true) }}

# Mirrors the chart's default hardened securityContext, adding only NET_RAW
# when the icmp lanes are enabled (chart default drops ALL, which breaks the
# icmp prober with no error at deploy time — dmfdeploy/dmfdeploy#166 WP-D).
securityContext:
  runAsUser: 1000
  runAsGroup: 1000
  readOnlyRootFilesystem: true
  runAsNonRoot: true
  allowPrivilegeEscalation: false
  capabilities:
    drop: ["ALL"]
{% if blackbox_allow_icmp | bool %}
    add: ["NET_RAW"]
{% endif %}

serviceMonitor:
  enabled: false
