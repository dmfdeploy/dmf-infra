---
{% set _ntfy_receiver_url = ('http://' ~ prometheus_ntfy_bridge_name ~ '.' ~ prometheus_namespace ~ '.svc.cluster.local:8080/alertmanager') if (prometheus_ntfy_bridge_enabled | bool) else prometheus_alertmanager_ntfy_url %}
alertmanager:
  enabled: {{ prometheus_alertmanager_enabled | bool | lower }}
{% if prometheus_alertmanager_enabled | bool %}
  persistence:
    enabled: true
    size: {{ prometheus_alertmanager_storage_size }}
    storageClass: {{ prometheus_alertmanager_storage_class }}
  resources:
    requests:
      cpu: 20m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi
  # Umbrella chart prometheus-25.x delegates Alertmanager config to the
  # alertmanager subchart under this key. The older `alertmanagerFiles.alertmanager.yml`
  # top-level key is ignored on this chart version.
  config:
    global:
      resolve_timeout: 5m
    route:
      receiver: primary
      group_by: ['alertname', 'namespace']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      routes:
        - receiver: watchdog
          matchers:
            - alertname = "Watchdog"
          group_wait: 0s
          group_interval: 1m
          repeat_interval: 1m
    receivers:
      - name: primary
{% if prometheus_alertmanager_ntfy_url | length > 0 %}
        webhook_configs:
          - url: "{{ _ntfy_receiver_url }}"
            send_resolved: true
{% endif %}
      - name: watchdog
{% if prometheus_alertmanager_watchdog_url | length > 0 %}
        webhook_configs:
          - url: "{{ prometheus_alertmanager_watchdog_url }}"
            send_resolved: false
{% endif %}
    inhibit_rules: []
{% endif %}

prometheus-pushgateway:
  enabled: false

kube-state-metrics:
  enabled: true
  # umbrella #276: measured request honesty (2026-07-24 sample archive);
  # requests-only, no limits.
  resources:
{{ prometheus_kube_state_metrics_resources | to_nice_yaml(indent=2) | indent(4, true) }}

prometheus-node-exporter:
  enabled: true
  # umbrella #276: measured request honesty (2026-07-24 sample archive);
  # requests-only, no limits.
  resources:
{{ prometheus_node_exporter_resources | to_nice_yaml(indent=2) | indent(4, true) }}

# umbrella #276: measured request honesty (2026-07-24 sample archive);
# requests-only, no limits. This is the configmap-reload SIDECAR in the
# prometheus-server pod — the main server container's own resources stay
# under server.resources below, untouched.
configmapReload:
  prometheus:
    resources:
{{ prometheus_configmap_reload_resources | to_nice_yaml(indent=2) | indent(6, true) }}

server:
  persistentVolume:
    enabled: true
    size: {{ prometheus_storage_size }}
    storageClass: {{ prometheus_storage_class }}
    annotations:
      numberOfReplicas: "2"

  retention: "{{ prometheus_retention }}"

  # retentionSize must be set via extraArgs (not a native Helm value)
  extraArgs:
    storage.tsdb.retention.size: "{{ prometheus_retention_size }}"

  resources:
{{ prometheus_resources | to_nice_yaml(indent=2) | indent(4, true) }}

  baseURL: "{{ prometheus_path }}"
  prefixURL: "{{ prometheus_path }}"

# ──────────────────────────────────────────────────────────────
# serverFiles — prometheus.yml scrape_configs + recording/alerting rules
# (rules always deploy; only Watchdog/notify alerts are AM-gated — see below)
#
# scrape_configs is vendored from chart-default (prometheus-25.8.0) so we can
# patch the `prometheus` self-scrape job's metrics_path to match
# server.prefixURL (--web.route-prefix). Without this fix the self-scrape job
# 404s on /metrics (because route-prefix moved it to {{ prometheus_path }}/metrics)
# and shows perpetually down in the Targets page on every env. Helm replaces
# lists wholesale (no partial merge for scrape_configs), so vendoring is the
# cleanest way to fix just the one entry while keeping the other 9 chart-default
# jobs intact. Refresh scrape_configs.yml.j2 when bumping the prometheus chart.
# ──────────────────────────────────────────────────────────────
serverFiles:
  prometheus.yml:
    scrape_configs:
{% include 'scrape_configs.yml.j2' %}
  # ──────────────────────────────────────────────────────────────
  # Rules-as-code (dmfdeploy/dmfdeploy#166): discrete, diffable rule files
  # under the role, slurped into the chart's serverFiles keys.
  #   files/rules/recording.yaml       — pure YAML, promtool-checkable as-is
  #   templates/rules/alerts.yaml.j2   — low-logic template (threshold vars)
  # The from_yaml round-trip validates both parse at render time.
  # Rules deploy regardless of Alertmanager state: the are-we-ok verdict pane
  # reads ALERTS directly from Prometheus (fail-soft, plan D3); only the
  # Watchdog/notify-path alerts are gated on prometheus_alertmanager_enabled
  # inside the template. The chart-default prometheus.yml rule_files list
  # already references /etc/config/{recording,alerting}_rules.yml.
  # Alertmanager routing + receivers live under alertmanager.config (above).
  # ──────────────────────────────────────────────────────────────
  recording_rules.yml:
{{ lookup('file', role_path + '/files/rules/recording.yaml') | from_yaml | to_nice_yaml(indent=2) | indent(4, true) }}
  alerting_rules.yml:
{{ lookup('template', role_path + '/templates/rules/alerts.yaml.j2') | from_yaml | to_nice_yaml(indent=2) | indent(4, true) }}
