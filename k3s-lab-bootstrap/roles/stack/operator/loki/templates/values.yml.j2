---
deploymentMode: SingleBinary

loki:
  auth_enabled: false
  commonConfig:
    replication_factor: 1
  schemaConfig:
    configs:
      - from: "2024-01-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index:
          prefix: index_
          period: 24h
  storage:
    type: filesystem
  # Compactor must be enabled for retention to delete data. Without this,
  # limits_config.retention_period below is policy-but-not-enforced.
  compactor:
    working_directory: /var/loki/compactor
    retention_enabled: true
    retention_delete_delay: {{ loki_compactor_retention_delete_delay }}
    retention_delete_worker_count: {{ loki_compactor_retention_delete_worker_count }}
    delete_request_store: filesystem
  limits_config:
    # Default retention floor; security streams override below.
    retention_period: {{ loki_retention }}
    # umbrella #313: per-stream ingestion caps — see loki_per_stream_rate_
    # limit's own comment in defaults/main.yml for the full rationale
    # (below Loki's 3.0 defaults; paired with the mandatory
    # LokiPerStreamRateLimitDropping{,Bytes} alerts — never silent).
    per_stream_rate_limit: {{ loki_per_stream_rate_limit }}
    per_stream_rate_limit_burst: {{ loki_per_stream_rate_limit_burst }}
    # Per-stream retention overrides. Keep selectors aligned with the
    # `job` label set in Promtail scrape configs and the per-app sidecars.
    retention_stream:
      - selector: '{job="k3s-audit"}'
        priority: 1
        period: {{ loki_security_retention }}
      - selector: '{job="authentik-audit"}'
        priority: 1
        period: {{ loki_security_retention }}
      - selector: '{job=~".+-security"}'
        priority: 1
        period: {{ loki_security_retention }}

singleBinary:
  replicas: 1
  persistence:
    enabled: true
    size: {{ loki_storage_size }}
    storageClass: {{ loki_storage_class }}
  # umbrella #276: measured request honesty (2026-07-24 sample archive);
  # requests-only, no limits.
  resources:
{{ loki_resources | to_nice_yaml(indent=2) | indent(4, true) }}

backend:
  replicas: 0

read:
  replicas: 0

write:
  replicas: 0

gateway:
  enabled: true
  replicas: 1
  # umbrella #276: measured request honesty (2026-07-24 sample archive);
  # requests-only, no limits.
  resources:
{{ loki_gateway_resources | to_nice_yaml(indent=2) | indent(4, true) }}

lokiCanary:
  # umbrella #276: measured request honesty (2026-07-24 sample archive);
  # requests-only, no limits.
  resources:
{{ loki_canary_resources | to_nice_yaml(indent=2) | indent(4, true) }}

chunksCache:
  enabled: false

resultsCache:
  enabled: false
