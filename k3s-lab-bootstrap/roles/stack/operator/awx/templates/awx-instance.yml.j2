---
apiVersion: awx.ansible.com/v1beta1
kind: AWX
metadata:
  name: {{ awx_instance_name }}
  namespace: {{ awx_namespace }}
spec:
  # Admin configuration
  admin_user: {{ awx_admin_user }}
  admin_password_secret: {{ awx_instance_name }}-admin-password

  # Service configuration
  service_type: {{ awx_service_type }}

  # Replica counts — explicit scalars (NOT to_nice_yaml dicts).
  # awx-operator owns Deployment spec.replicas when *_manage_replicas is true;
  # awx-presence asleep merge-patches these to 0, awake restores them.
  web_replicas: {{ awx_web_replicas | int }}
  task_replicas: {{ awx_task_replicas | int }}
  web_manage_replicas: {{ awx_web_manage_replicas | bool | lower }}
  task_manage_replicas: {{ awx_task_manage_replicas | bool | lower }}

  # PostgreSQL storage
  postgres_storage_class: {{ awx_postgres_storage_class }}
  postgres_storage_requirements:
    requests:
      storage: {{ awx_postgres_storage_size }}

  # Fix Longhorn volume permissions for PostgreSQL (runs as UID 26)
  postgres_data_volume_init: true

  # Projects storage (for playbook storage)
  projects_persistence: true
  projects_storage_class: {{ awx_projects_storage_class }}
  projects_storage_size: {{ awx_projects_storage_size }}
  projects_storage_access_mode: {{ awx_projects_storage_access_mode }}

  # Match AWX's own URL/cookie settings to the selected exposure model.
  extra_settings:
{% if awx_exposure | default('host') == 'host' %}
    - setting: TOWER_URL_BASE
      value: "'{{ awx_external_base_url }}'"
    - setting: STATIC_URL
      value: "'/static/'"
    - setting: CSRF_COOKIE_PATH
      value: "'/'"
    - setting: SESSION_COOKIE_PATH
      value: "'/'"
{% else %}
    - setting: TOWER_URL_BASE
      value: "'{{ awx_path }}'"
    - setting: STATIC_URL
      value: "'{{ awx_path }}/static/'"
    - setting: CSRF_COOKIE_PATH
      value: "'{{ awx_path }}'"
    - setting: SESSION_COOKIE_PATH
      value: "'{{ awx_path }}'"
{% endif %}
{% if awx_max_forks is defined %}
    # Global hard ceiling on forks per job (Settings → Jobs → "Maximum number
    # of forks per job"). On the single-node sandbox profile this bounds the
    # per-job fan-out so one playbook run can't oversubscribe a 10 GiB node.
    # Lab/cloud leave awx_max_forks undefined → no global ceiling (the lane
    # wants throughput). This is the ONLY job-resource knob reachable via
    # extra_settings; see the InstanceGroup note at the bottom of this file.
    - setting: MAX_FORKS
      value: {{ awx_max_forks | int }}
{% endif %}
{% if awx_saml_enabled | default(false) | bool %}
{% set _awx_saml_enabled_idps = {
  awx_saml_idp_name: {
    'entity_id': awx_saml_idp_entity_id,
    'url': awx_saml_idp_sso_url,
    'x509cert': awx_saml_idp_certificate_effective,
    'attr_username': 'http://schemas.goauthentik.io/2021/02/saml/username',
    'attr_user_permanent_id': 'http://schemas.goauthentik.io/2021/02/saml/uid',
    'attr_email': 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
    'attr_first_name': 'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name'
  }
} %}
    - setting: AUTHENTICATION_BACKENDS
      value: ["awx.sso.backends.TACACSPlusBackend", "awx.main.backends.AWXModelBackend", "social_core.backends.saml.SAMLAuth"]
    - setting: SOCIAL_AUTH_SAML_SP_ENTITY_ID
      value: "'{{ awx_saml_sp_entity_id }}'"
    - setting: SOCIAL_AUTH_SAML_ORG_INFO
      value: {{ awx_saml_org_info | to_json }}
    - setting: SOCIAL_AUTH_SAML_TECHNICAL_CONTACT
      value: {{ awx_saml_technical_contact | to_json }}
    - setting: SOCIAL_AUTH_SAML_SUPPORT_CONTACT
      value: {{ awx_saml_support_contact | to_json }}
    - setting: SOCIAL_AUTH_SAML_ENABLED_IDPS
      value: {{ _awx_saml_enabled_idps | to_json }}
    - setting: SOCIAL_AUTH_SAML_USER_FLAGS_BY_ATTR
      value: {{ awx_saml_user_flags_by_attr | to_json }}
{% if awx_saml_explicit_pipeline | default(false) | bool %}
    - setting: SOCIAL_AUTH_PIPELINE
      value: {{ awx_saml_social_auth_pipeline | to_json }}
{% endif %}
{% if awx_saml_login_redirect_override | default('') | length > 0 %}
    - setting: LOGIN_REDIRECT_OVERRIDE
      value: "'{{ awx_saml_login_redirect_override }}'"
{% endif %}
{% endif %}

  # Disable built-in ingress (we use Traefik IngressRoute)
  ingress_type: none

{# Control-plane execution environment (umbrella dmfdeploy/dmfdeploy#327).
   spec.control_plane_ee_image is a real, honoured field at awx-operator 2.19.1
   — verified end-to-end, unlike spec.ee_pod_spec_override at the bottom of this
   file: CRD config/crd/bases/awx.ansible.com_awxs.yaml:1347-1349 (type string),
   override wiring roles/installer/tasks/resources_configuration.yml:29-35,
   consumed at roles/installer/templates/deployments/task.yaml.j2:355 and
   templates/settings/execution_environments.py.j2:6. Note the operator's own
   template reads the underscore-prefixed _control_plane_ee_image, so this only
   works because resources_configuration.yml:35 folds the public spec field in.
   Empty → field omitted → the operator's default awx-ee:24.6.1 resumes. #}
{% if awx_control_plane_ee_image | default('') | length > 0 %}
  # Pinned by digest; see the defaults' bump procedure before changing it.
  control_plane_ee_image: "{{ awx_control_plane_ee_image }}"
{% endif %}
{# Receptor's pod-log retry budget, delivered to the awx-ee container. The CRD
   types ee_extra_env as a STRING (a block scalar holding a YAML list), not a
   list — the operator splices it with indent(width=12, first=True) into the
   env: of the <instance-name>-ee container of the awx-task Deployment, i.e.
   the container running `exec receptor`. Kubernetes
   env values must themselves be strings, so the rendered int is explicitly
   quoted: bare inline Jinja would emit `value: 60`, which the API rejects. #}
{% if awx_receptor_kube_retry_count is defined %}
  ee_extra_env: |
    - name: RECEPTOR_KUBE_RETRY_COUNT
      value: "{{ awx_receptor_kube_retry_count | int }}"
{% endif %}

  # Scheduling and resources
{% if awx_web_resource_requirements is defined %}
  web_resource_requirements:
{{ awx_web_resource_requirements | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% if awx_task_resource_requirements is defined %}
  task_resource_requirements:
{{ awx_task_resource_requirements | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% if awx_postgres_resource_requirements is defined %}
  postgres_resource_requirements:
{{ awx_postgres_resource_requirements | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{# umbrella dmfdeploy/dmfdeploy#258 round 2 — redis/rsyslog/ee sidecars,
   verified against the awx-operator CRD (redis_resource_requirements,
   rsyslog_resource_requirements, ee_resource_requirements are all real
   spec fields; the operator's own role defaults ship requests-only, no
   limits, for these three — see the sandbox-profile fit-vars' own
   comment for the exact values these override). Same undefined-by-
   default convention as postgres above: lab/cloud envs that never set
   these vars get the operator's own internal defaults untouched. #}
{% if awx_redis_resource_requirements is defined %}
  redis_resource_requirements:
{{ awx_redis_resource_requirements | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% if awx_rsyslog_resource_requirements is defined %}
  rsyslog_resource_requirements:
{{ awx_rsyslog_resource_requirements | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% if awx_ee_resource_requirements is defined %}
  ee_resource_requirements:
{{ awx_ee_resource_requirements | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% if awx_web_affinity is defined %}
  web_affinity:
{{ awx_web_affinity | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% if awx_task_affinity is defined %}
  task_affinity:
{{ awx_task_affinity | to_nice_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% if awx_web_uwsgi_processes is defined %}
  # Number of uwsgi processes per web container (awx-operator 2.19.1 CRD field).
  # Default AWX behaviour is ~5 workers; the sandbox prelude caps to 2 on
  # constrained nodes (proven on 8 GB Pi 4, issue #93). Lab/cloud leave this
  # undefined → no override, AWX uses its built-in default.
  uwsgi_processes: {{ awx_web_uwsgi_processes | int }}
{% endif %}

# DEFERRED (2026-05-06): the spec.ee_pod_spec_override field below is NOT a
# valid AWX operator CRD field. The k8s apply succeeds (returns ok) but the
# field is silently dropped — the AWX CR warns "unknown field
# spec.ee_pod_spec_override". Setting EE pod spec must instead PATCH the
# InstanceGroup pod_spec_override via the AWX REST API
# (/api/v2/instance_groups/{id}/) — the AWX CR has no stable field for this.
#
# Media catalog launchers now use ADR-0025 Container Groups in
# awx-integration. 693-class infrastructure plays continue to use ADR-0016
# Path A for control-node SSH. See:
#   docs/plans/Move 1 Gate 2 - Pivot to Path A for Catalog Launchers 2026-05-06.md
#   docs/decisions/0012-configure-stage-distinct-from-provision.md (impl note)
#
# When/if this is revisited, write a new task in awx-integration that PATCHes
# the InstanceGroup directly via the AWX API. Do NOT re-enable this fragment.
#
# SAME BLIND SPOT — job concurrency (WP1S Phase 3, single-node fit):
# `max_concurrent_jobs` and `max_forks` are fields on the InstanceGroup /
# ContainerGroup, NOT AWX Django settings — so they CANNOT be set via
# extra_settings (SCHEDULE_MAX_JOBS / DEFAULT_EXECUTION_QUEUE_MAX_CONCURRENT_JOBS
# are not real AWX settings; verified against AWX 24.6 docs 2026-05-29). The
# per-job fork ceiling we CAN set globally is MAX_FORKS (a real Django setting,
# wired above via awx_max_forks). The concurrency cap on the media catalog
# queue IS applied — by awx-integration via the InstanceGroup REST API
# (/api/v2/instance_groups/, set on both create POST and update PATCH of
# dmf-catalog-cg; umbrella #254, var awx_dmf_catalog_cg_max_concurrent_jobs),
# not here; the REST API is the only way to set this field, same as the EE
# pod spec override above. This fragment stays disabled for the same reason:
# the AWX CR has no field for it.
#
#   ee_pod_spec_override: |
# {{ '{{ awx_ee_pod_spec_override | indent(4, true) }}' }}
