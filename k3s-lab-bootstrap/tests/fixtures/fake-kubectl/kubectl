#!/usr/bin/env bash
# Fake kubectl for the OpenBao tests (tests/test-openbao-*.yml). It handles three
# call forms:
#   kubectl [flags] exec [-i] POD -- COMMAND...
#     It runs COMMAND here, with the fake bao (tests/fixtures/fake-bao/bao) first on
#     PATH and the pod name in FAKE_POD. Standard input passes through, as it does
#     with `kubectl exec -i`. The command `sh -c 'cat > PATH'` does not run: the
#     fake keeps its standard input as $FAKE_STATE/pod-fs/POD/PATH instead.
#   kubectl [flags] get secret NAME -o jsonpath=...
#     It prints the tls.crt of $FAKE_STATE/k8s/Secret-NAME.json, or the text
#     "stale" (base64) for the first $FAKE_CERT_STALE_READS reads, as a secret that
#     cert-manager has not replaced yet.
#   kubectl [flags] -n NAMESPACE annotate --overwrite externalsecret/NAME KEY=VALUE
#     It sets the annotation on $FAKE_STATE/k8s/ExternalSecret-NAME.json and then
#     writes the status as ESO does after a successful sync: Ready with reason
#     SecretSynced and the version that tests/fixtures/eso_sync_version.py computes
#     for the object's metadata. FAKE_ES_SYNC selects what ESO does:
#       sync    (default) publishes the version for the annotated metadata.
#       hold    keeps the status as it was, as for an ExternalSecret that ESO has not
#               synced or whose sync failed.
#       other   publishes the version for other metadata, an earlier change without
#               this annotation, as ESO does while it still processes that change.
#       scheme  publishes a version that is built differently from ESO's.
#       collide another writer first cuts the marker text out of every annotation value
#               that embeds it, then the status stays as it was: the status holds the
#               version of the metadata as it was rendered with the embedded marker.
#   Inside `exec`, two commands do not run here. `cat /openbao/config/tls/FILE...`
#   prints what the kubelet projects from k8s/Secret-openbao-tls.json (tls.crt, tls.key,
#   ca.crt); for the first $FAKE_PROJECTION_LAG calls to a pod it prints the text
#   "stale-projection" instead, as a pod whose volume has not been updated yet.
#   `sh -c 'kill -HUP 1'` is the reload signal. With FAKE_TLS_MODEL set it makes the
#   pod serve the projected tls.crt (state file served-POD), unless FAKE_HUP_IGNORED is
#   set. The fake never runs `kill`: a real one would signal the host.
# Every call is logged to $FAKE_STATE/events.log. Any other call fails, so a test
# notices a new kind of call.
set -u
pod=""
state="${FAKE_STATE:-}"
# Every call, with its full argument list, goes to $FAKE_STATE/kubectl-argv.log, so a
# test can prove that no secret reached the arguments of kubectl.
[ -n "$state" ] && { mkdir -p "$state"; printf '%s\n' "$*" >> "$state/kubectl-argv.log"; }
log_event() { [ -n "$state" ] && { mkdir -p "$state"; printf '%s\n' "$*" >> "$state/events.log"; }; return 0; }
case " $* " in
  *" annotate "*)
    target=""
    pair=""
    for a in "$@"; do
      case "$a" in
        externalsecret/*) target="${a#externalsecret/}" ;;
        *=*) pair="$a" ;;
      esac
    done
    log_event "kubectl annotate externalsecret $target $pair"
    fixtures="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    python3 - "$state/k8s/ExternalSecret-$target.json" "$pair" "$fixtures" <<'PY'
import json
import os
import sys

path, pair, fixtures = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.insert(0, fixtures)
import eso_sync_version

key, value = pair.split("=", 1)
with open(path) as handle:
    data = json.load(handle)
annotations = data["metadata"].setdefault("annotations", {})
mode = os.environ.get("FAKE_ES_SYNC", "sync")
if mode == "collide":
    for name, text in list(annotations.items()):
        annotations[name] = text.split(" force-sync:")[0]
annotations[key] = value
if mode == "sync":
    data["status"] = eso_sync_version.synced_status(data, refresh_time="2000-01-01T00:00:00Z")
elif mode == "other":
    data["status"] = eso_sync_version.synced_status(
        {"metadata": {**data["metadata"], "annotations": {k: v for k, v in annotations.items() if k != key}}},
        extra_annotations={"earlier-change": "published"},
    )
elif mode == "scheme":
    data["status"] = eso_sync_version.synced_status(data, scheme="other")
with open(path, "w") as handle:
    json.dump(data, handle)
PY
    exit 0
    ;;
  *" get secret "*)
    secret=""
    prev=""
    for a in "$@"; do
      [ "$prev" = secret ] && secret="$a"
      prev="$a"
    done
    log_event "kubectl get secret $secret"
    n=0
    [ -f "$state/count-secret-$secret" ] && n="$(cat "$state/count-secret-$secret")"
    echo $((n + 1)) > "$state/count-secret-$secret"
    if [ "$n" -lt "${FAKE_CERT_STALE_READS:-0}" ]; then
      printf 'stale' | base64
    else
      python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["data"]["tls.crt"], end="")' "$state/k8s/Secret-$secret.json"
    fi
    exit 0
    ;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    exec) shift; break ;;
    *) shift ;;
  esac
done
while [ $# -gt 0 ]; do
  case "$1" in
    -i|-it|-t) shift ;;
    --) shift; break ;;
    *) pod="$1"; shift ;;
  esac
done
if [ -z "$pod" ] || [ $# -eq 0 ]; then
  echo "fake kubectl: unexpected call" >&2
  exit 1
fi
# FAKE_MISSING lists pods that do not exist: a call to one fails as kubectl does.
case " ${FAKE_MISSING:-} " in
  *" $pod "*) echo "Error from server (NotFound): pods \"$pod\" not found" >&2; exit 1 ;;
esac
if [ $# -eq 3 ] && [ "$1" = sh ] && [ "$2" = -c ] && [ "${3#cat > /}" != "$3" ]; then
  dest="${3#cat > }"
  mkdir -p "$state/pod-fs/$pod$(dirname "$dest")"
  cat > "$state/pod-fs/$pod$dest"
  log_event "kubectl exec $pod write $dest"
  exit 0
fi
projected() { # projected KEY -> the decoded value in the projected secret
  python3 -c 'import base64,json,sys; print(base64.b64decode(json.load(open(sys.argv[1]))["data"].get(sys.argv[2], "")).decode(), end="")' "$state/k8s/Secret-openbao-tls.json" "$1"
}
if [ "$1" = cat ] && [ "${2#/openbao/config/tls/}" != "$2" ]; then
  shift
  log_event "kubectl exec $pod cat $*"
  n=0
  [ -f "$state/count-projection-$pod" ] && n="$(cat "$state/count-projection-$pod")"
  echo $((n + 1)) > "$state/count-projection-$pod"
  if [ "$n" -lt "${FAKE_PROJECTION_LAG:-0}" ]; then
    printf 'stale-projection'
    exit 0
  fi
  for f in "$@"; do
    projected "$(basename "$f")"
  done
  exit 0
fi
if [ $# -eq 3 ] && [ "$1" = sh ] && [ "$2" = -c ] && [ "$3" = "kill -HUP 1" ]; then
  log_event "kubectl exec $pod sighup"
  if [ -n "${FAKE_TLS_MODEL:-}" ] && [ -z "${FAKE_HUP_IGNORED:-}" ]; then
    projected tls.crt > "$state/served-$pod"
  fi
  exit 0
fi
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export FAKE_POD="$pod"
export PATH="$here/../fake-bao:$PATH"
exec "$@"
