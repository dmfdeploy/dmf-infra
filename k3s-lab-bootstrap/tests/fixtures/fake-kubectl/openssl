#!/usr/bin/env bash
# Fake openssl for tests/test-openbao-grow-ha.yml. It answers only
# `openssl x509 -noout -ext subjectAltName` and reads the certificate on stdin:
#   - "dnsNames:a,b" (written by the fake kubernetes.core when the play creates the
#     Certificate): it prints those names, so the test sees what the play rendered;
#   - "stale": a certificate that does not cover the Raft peers yet;
#   - anything else (the certificate that the install had before): the names of a
#     single-replica install.
# The macOS openssl is LibreSSL, which has no `-ext` option, and the migration's
# certificate check runs on a Linux node.
case "$*" in
  "x509 -noout -ext subjectAltName")
    crt="$(cat)"
    case "$crt" in
      dnsNames:*)
        names="$(printf '%s' "${crt#dnsNames:}" | sed 's/,/, DNS:/g')"
        printf 'X509v3 Subject Alternative Name: \n    DNS:%s\n' "$names"
        ;;
      *)
        printf 'X509v3 Subject Alternative Name: \n    DNS:openbao\n'
        ;;
    esac
    exit 0
    ;;
esac
echo "fake openssl: unexpected call: $*" >&2
exit 1
