#!/usr/bin/env bash
# Fake bao for the OpenBao tests. It answers the calls that the role and the
# guard make, from a state directory ($FAKE_STATE) and scenario variables, and it
# logs every argument list to $FAKE_STATE/bao-argv.log so a test can prove that no
# secret arrives as an argument. It follows OpenBao v2.5.2:
#   - `bao status` exits 0 unsealed and 2 sealed (command/status.go).
#   - `bao write PATH -` reads a JSON object from stdin, and `key=-` reads the
#     whole of stdin as the value (go-secure-stdlib kv-builder v0.1.2, builder.go).
#   - `bao operator unseal KEY` takes the key as its positional argument.
#   - `bao kv metadata get` prints "No value found at ..." and exits 2 for a
#     missing path, and exits 2 with "Error reading ..." for other failures
#     (command/kv_metadata_get.go).
#   - `bao token capabilities -format=json` prints a JSON list.
#   - `bao read -format=json sys/storage/raft/autopilot/state` prints the API
#     response: the state object, with snake_case keys (healthy, failure_tolerance,
#     leader, voters, servers), is under "data".
#   - `bao read -format=json sys/storage/raft/configuration` prints the API response:
#     data.config.servers is a list of {node_id, address, leader, voter}.
#   - `bao operator raft autopilot state -format=json` prints the same state with Go
#     field names (Healthy, FailureTolerance, Servers, NodeType, LastContact), as
#     OpenBao 2.5.2 does. The guard must not read this form, so a caller that does
#     fails the tests.
# Scenario variables (all optional):
#   FAKE_SEALED          space-separated pods that start sealed
#   FAKE_THRESHOLD       shares that unseal a pod (default 3)
#   FAKE_VALID_KEYS      space-separated accepted keys (default: any non-empty key)
#   FAKE_PASSWORD        accepted userpass password (default: pw)
#   FAKE_AUTOPILOT       healthy | unhealthy | stale | missing | delayed | denied | down |
#                        service_address (node 1 at the Service address)
#   FAKE_PEER_DOMAIN     what follows <pod>. in a Raft address (default
#                        openbao-internal.openbao.svc.cluster.local)
#   FAKE_RAFT_CONFIG     healthy | service_address | denied  (node 1's address in the
#                        Raft configuration; file raft-config in the state directory wins)
#   FAKE_PROMOTE_AFTER   with delayed: autopilot calls before the new voter is healthy
#   FAKE_CAPS_MISSING    space-separated paths on which the token has no capability
#   FAKE_CAPS_JSON       capability list for every other path (default ["read"])
#   FAKE_ESO_PKI_GRANT   capability list that a token named fake-eso* holds on pki/*
#                        (default ["deny"], a path without a grant)
#   FAKE_KV_MODE         ok | absent | denied | transport  (file $FAKE_STATE/kv-mode wins)
#   FAKE_KV_VERSION      version that `kv metadata get` reports (file kv-version wins)
#   FAKE_K8S_IGNORES_REVIEWER_FIELDS  set: an old mount, whose config read has no
#                        token_reviewer_jwt_set field
#   FAKE_K8S_WRITE_FAILS set: a write to auth/kubernetes/role/* fails
# Kubernetes auth: the config and the roles are files under $state/k8s-auth. A token
# whose name starts with fake-root is a root token and may read and write
# auth/kubernetes/*; every other token gets 403 on a write. A token revoked with
# `bao token revoke -self` (file revoked-<token>) is refused everywhere. A config
# write rebuilds the config from its fields, as the mount does, and token_reviewer_jwt
# set to "" stores no token. A pem_keys value that does not parse fails after the
# permission check. A role write takes its fields as key=value arguments or, with `-`,
# as a JSON object on stdin, where a TTL is a number of seconds or a duration such as
# 5m. A root token reads sys/policies/acl/NAME: the policy exists when the file
# $state/policies/NAME does.
set -u
state="${FAKE_STATE:?FAKE_STATE is not set}"
pod="${FAKE_POD:-openbao-0}"
mkdir -p "$state"
printf '%s\n' "$*" >> "$state/bao-argv.log"
# One log of every call in order, shared with the fake kubectl and the fake
# kubernetes.core modules, so a test can check what ran before what.
printf 'bao %s %s\n' "$pod" "$*" >> "$state/events.log"

pod_in() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
progress_file="$state/progress-$pod"
unsealed_file="$state/unsealed-$pod"
# A pod that the fake kubernetes.core.k8s deleted comes back sealed.
sealed_file="$state/sealed-$pod"
is_sealed() {
  [ -f "$unsealed_file" ] && return 1
  [ -f "$sealed_file" ] && return 0
  pod_in "$pod" "${FAKE_SEALED:-}" && return 0
  return 1
}
read_kv() { [ -f "$state/$1" ] && cat "$state/$1" || printf '%s' "$2"; }
count_call() { # count_call NAME -> prints the number of earlier calls, then records this one
  local n=0
  [ -f "$state/count-$1" ] && n="$(cat "$state/count-$1")"
  echo $((n + 1)) > "$state/count-$1"
  printf '%s' "$n"
}

case "$*" in
  "status -format=json")
    if is_sealed; then
      printf '{"initialized":true,"sealed":true,"t":3,"n":5,"progress":%s}\n' "$(cat "$progress_file" 2>/dev/null || echo 0)"
      exit 2
    fi
    printf '{"initialized":true,"sealed":false,"t":3,"n":5,"progress":0,"is_self":true}\n'
    exit 0
    ;;
  "write -format=json sys/unseal -")
    body="$(cat)"
    key="$(printf '%s' "$body" | python3 -c 'import json,sys
d=json.load(sys.stdin)
k=d.get("key")
sys.exit(1) if not isinstance(k,str) or not k else print(k)' 2>/dev/null)" || { echo "Error writing data to sys/unseal: invalid JSON body or no key" >&2; exit 2; }
    if [ -n "${FAKE_VALID_KEYS:-}" ] && ! pod_in "$key" "$FAKE_VALID_KEYS"; then
      echo "Error writing data to sys/unseal: invalid key" >&2
      exit 2
    fi
    n=$(( $(cat "$progress_file" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$progress_file"
    if [ "$n" -ge "${FAKE_THRESHOLD:-3}" ]; then touch "$unsealed_file"; rm -f "$sealed_file"; fi
    printf '{"sealed":%s,"progress":%s}\n' "$([ -f "$unsealed_file" ] && echo false || echo true)" "$n"
    exit 0
    ;;
  "operator unseal "*)
    # The key is a positional argument: record it, and reject the stdin marker.
    key="${3:-}"
    printf 'POSITIONAL-UNSEAL-KEY\n' >> "$state/positional.log"
    [ "$key" = "-" ] && { echo "Error unsealing: invalid key" >&2; exit 2; }
    exit 2
    ;;
  "write -format=json auth/userpass/login/"*" password=-")
    pw="$(cat)"
    if [ "$pw" != "${FAKE_PASSWORD:-pw}" ]; then echo "Error writing data: invalid credentials" >&2; exit 2; fi
    printf '{"auth":{"client_token":"fake-ops-token"}}\n'
    exit 0
    ;;
  "read -format=json sys/storage/raft/autopilot/state"|"operator raft autopilot state -format=json")
    [ -n "${BAO_TOKEN:-}" ] || { echo "Error reading autopilot state: permission denied" >&2; exit 2; }
    n="$(count_call autopilot)"
    case "${FAKE_AUTOPILOT:-healthy}" in
      denied) echo "Error reading autopilot state: permission denied" >&2; exit 2 ;;
      down) echo "Error reading autopilot state: dial tcp: connection refused" >&2; exit 2 ;;
    esac
    form=api
    [ "$1" = "operator" ] && form=cli
    python3 - "${FAKE_AUTOPILOT:-healthy}" "$n" "${FAKE_PROMOTE_AFTER:-0}" "$form" "${FAKE_PEER_DOMAIN:-openbao-internal.openbao.svc.cluster.local}" <<'PY'
import json, sys
scenario, calls, promote_after, form, domain = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4], sys.argv[5]
def server(sid, healthy=True, node_type="voter", last_contact="12ms"):
    # Node 1 is pod 0. Each pod is at <pod>.<headless service>.<namespace>.svc:8201.
    pod = "openbao-0" if sid == "1" else sid
    return {"id": sid, "name": sid, "address": pod + "." + domain + ":8201",
            "node_status": "alive", "last_contact": last_contact, "last_term": 3, "last_index": 100,
            "healthy": healthy, "stable_since": "2026-01-01T00:00:00Z", "status": "leader" if sid == "1" else "voter",
            "version": "2.5.2", "node_type": node_type}
servers = {"1": server("1", last_contact="0s"), "openbao-1": server("openbao-1"), "openbao-2": server("openbao-2")}
state = {"healthy": True, "failure_tolerance": 1, "leader": "1", "voters": ["1", "openbao-1", "openbao-2"], "servers": servers}
if scenario == "service_address":
    servers["1"]["address"] = "openbao.openbao.svc.cluster.local:8201"
elif scenario == "unhealthy":
    servers["openbao-2"]["healthy"] = False
    state["healthy"] = False
    state["failure_tolerance"] = 0
elif scenario == "stale":
    servers["openbao-2"]["last_contact"] = "1m30.5s"
elif scenario == "missing":
    del servers["openbao-2"]
    state["voters"] = ["1", "openbao-1"]
elif scenario == "delayed" and calls < promote_after:
    servers["openbao-2"]["node_type"] = "non-voter"
    servers["openbao-2"]["healthy"] = False
    state["voters"] = ["1", "openbao-1"]
    state["non_voters"] = ["openbao-2"]
    state["failure_tolerance"] = 0

def go_name(key):
    # The CLI prints Go struct field names: id -> ID, node_type -> NodeType.
    return "ID" if key == "id" else "".join(part.capitalize() for part in key.split("_"))

def go_form(obj):
    return {go_name(k): v for k, v in obj.items()}

if form == "api":
    print(json.dumps({"request_id": "00000000-0000-4000-8000-000000000000", "lease_id": "",
                      "lease_duration": 0, "renewable": False, "data": state, "warnings": None}))
else:
    cli = go_form(state)
    cli["Servers"] = {sid: dict(go_form(srv), UpgradeVersion="") for sid, srv in servers.items()}
    cli.setdefault("NonVoters", None)
    cli["Upgrade"] = None
    cli["OptimisticFailureTolerance"] = state["failure_tolerance"]
    print(json.dumps(cli, indent=2))
PY
    exit 0
    ;;
  "read -format=json sys/storage/raft/configuration")
    [ -n "${BAO_TOKEN:-}" ] || { echo "Error reading sys/storage/raft/configuration: permission denied" >&2; exit 2; }
    mode="$(read_kv raft-config "${FAKE_RAFT_CONFIG:-healthy}")"
    [ "$mode" = denied ] && { echo "Error reading sys/storage/raft/configuration: permission denied" >&2; exit 2; }
    node1="openbao-0.${FAKE_PEER_DOMAIN:-openbao-internal.openbao.svc.cluster.local}:8201"
    [ "$mode" = service_address ] && node1="openbao.openbao.svc.cluster.local:8201"
    printf '{"request_id":"00000000-0000-4000-8000-000000000000","data":{"config":{"index":1,"servers":[{"address":"%s","leader":true,"node_id":"1","protocol_version":"3","voter":true}]}}}\n' "$node1"
    exit 0
    ;;
  "token capabilities -format=json "*)
    [ -n "${BAO_TOKEN:-}" ] || { echo "Error: permission denied" >&2; exit 2; }
    path="${4:-}"
    # A token whose name starts with fake-eso carries eso-reader. It can read the KV
    # secrets and, unless FAKE_ESO_PKI_GRANT holds a capability list, has nothing on any
    # other path: OpenBao answers a path without a grant with ["deny"].
    case "${BAO_TOKEN:-}" in
      fake-eso*)
        case "$path" in
          secret/*) printf '["read"]\n' ;;
          pki/*) printf '%s\n' "${FAKE_ESO_PKI_GRANT:-[\"deny\"]}" ;;
          *) printf '["deny"]\n' ;;
        esac
        exit 0
        ;;
    esac
    if pod_in "$path" "${FAKE_CAPS_MISSING:-}"; then printf '["deny"]\n'; else printf '%s\n' "${FAKE_CAPS_JSON:-[\"read\"]}"; fi
    exit 0
    ;;
  "kv metadata get -mount=secret -format=json "*)
    [ -n "${BAO_TOKEN:-}" ] || { echo "Error reading secret/metadata/x: permission denied" >&2; exit 2; }
    path="${6:-}"
    mode="$(read_kv kv-mode "${FAKE_KV_MODE:-ok}")"
    case "$mode" in
      denied) echo "Error reading secret/metadata/$path: Error making API request. Code: 403. Errors: * 1 error occurred: * permission denied" >&2; exit 2 ;;
      transport) echo "Error reading secret/metadata/$path: Get \"https://127.0.0.1:8200/v1/secret/metadata/$path\": dial tcp 127.0.0.1:8200: connect: connection refused" >&2; exit 2 ;;
      absent) echo "No value found at secret/metadata/$path" >&2; exit 2 ;;
    esac
    # A path whose name ends in -missing is absent even in ok mode.
    case "$path" in *-missing) echo "No value found at secret/metadata/$path" >&2; exit 2 ;; esac
    printf '{"data":{"current_version":%s,"updated_time":"2026-11-08T00:00:00Z"}}\n' "$(read_kv kv-version "${FAKE_KV_VERSION:-1}")"
    exit 0
    ;;
esac
k8s_auth_dir="$state/k8s-auth"
token_ok() { [ -n "${BAO_TOKEN:-}" ] && [ ! -f "$state/revoked-$BAO_TOKEN" ]; }
is_root() { case "${BAO_TOKEN:-}" in fake-root*) return 0 ;; esac; return 1; }
forbidden() { printf 'Error %s: Error making API request.\n\nCode: 403. Errors:\n\n* 1 error occurred:\n\t* permission denied\n' "$1" >&2; exit 2; }
case "$*" in
  "token lookup -format=json")
    token_ok || forbidden "looking up token"
    if is_root; then printf '{"data":{"policies":["root"]}}\n'; else printf '{"data":{"policies":["default"]}}\n'; fi
    exit 0
    ;;
  "token revoke -self")
    token_ok || forbidden "revoking token"
    touch "$state/revoked-$BAO_TOKEN"
    exit 0
    ;;
  "write auth/kubernetes/config "*)
    token_ok && is_root || forbidden "writing data to auth/kubernetes/config"
    mkdir -p "$k8s_auth_dir"
    shift 2
    python3 - "$k8s_auth_dir/config.json" "$@" <<'PY'
import json, sys
path, fields = sys.argv[1], dict(a.split("=", 1) for a in sys.argv[2:])
if "pem_keys" in fields:
    print("Error writing data to auth/kubernetes/config: data does not contain any valid RSA or ECDSA public keys", file=sys.stderr)
    sys.exit(2)
config = {"kubernetes_host": fields.get("kubernetes_host", ""),
          "kubernetes_ca_cert": fields.get("kubernetes_ca_cert", ""),
          "token_reviewer_jwt_set": bool(fields.get("token_reviewer_jwt", "")),
          "disable_local_ca_jwt": fields.get("disable_local_ca_jwt", "false") == "true"}
json.dump(config, open(path, "w"))
PY
    exit $?
    ;;
  "read -format=json auth/kubernetes/config")
    token_ok && is_root || forbidden "reading auth/kubernetes/config"
    [ -f "$k8s_auth_dir/config.json" ] || { echo "No value found at auth/kubernetes/config" >&2; exit 2; }
    python3 - "$k8s_auth_dir/config.json" "${FAKE_K8S_IGNORES_REVIEWER_FIELDS:-}" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
if sys.argv[2]:
    data.pop("token_reviewer_jwt_set", None)
    data.pop("disable_local_ca_jwt", None)
print(json.dumps({"data": data}))
PY
    exit 0
    ;;
  "write auth/kubernetes/role/"*)
    token_ok && is_root || forbidden "writing data to auth/kubernetes/role"
    [ -z "${FAKE_K8S_WRITE_FAILS:-}" ] || { echo "Error writing data to auth/kubernetes/role: internal error" >&2; exit 2; }
    mkdir -p "$k8s_auth_dir"
    name="${2#auth/kubernetes/role/}"
    shift 2
    body=""
    [ "${1:-}" = "-" ] && { body="$(cat)"; shift; }
    FAKE_ROLE_BODY="$body" python3 - "$k8s_auth_dir/role-$name.json" "$@" <<'PY'
import json, os, sys
path, args = sys.argv[1], sys.argv[2:]
fields = dict(a.split("=", 1) for a in args)
if os.environ.get("FAKE_ROLE_BODY"):
    fields.update(json.loads(os.environ["FAKE_ROLE_BODY"]))

def as_list(value):
    return value if isinstance(value, list) else str(value).split(",")

def seconds(value):
    text = str(value or "0")
    units = {"s": 1, "m": 60, "h": 3600}
    return int(text[:-1]) * units[text[-1]] if text[-1] in units else int(text)

role = {"bound_service_account_names": as_list(fields["bound_service_account_names"]),
        "bound_service_account_namespaces": as_list(fields["bound_service_account_namespaces"]),
        "audience": fields.get("audience", ""),
        "token_policies": as_list(fields.get("token_policies", "")),
        "token_ttl": seconds(fields.get("token_ttl")),
        "token_max_ttl": seconds(fields.get("token_max_ttl"))}
json.dump(role, open(path, "w"))
PY
    exit $?
    ;;
  "read -format=json sys/policies/acl/"*)
    token_ok && is_root || forbidden "reading sys/policies/acl"
    name="${3#sys/policies/acl/}"
    [ -f "$state/policies/$name" ] || { echo "No value found at sys/policies/acl/$name" >&2; exit 2; }
    printf '{"data":{"name":"%s","policy":""}}\n' "$name"
    exit 0
    ;;
  "read -format=json auth/kubernetes/role/"*)
    token_ok && is_root || forbidden "reading auth/kubernetes/role"
    name="${3#auth/kubernetes/role/}"
    [ -f "$k8s_auth_dir/role-$name.json" ] || { echo "No value found at auth/kubernetes/role/$name" >&2; exit 2; }
    python3 -c 'import json,sys; print(json.dumps({"data": json.load(open(sys.argv[1]))}))' "$k8s_auth_dir/role-$name.json"
    exit 0
    ;;
esac
echo "fake bao: unexpected call: $*" >&2
exit 1
