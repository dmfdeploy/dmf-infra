#!/usr/bin/env bash
# Fake bao for the OpenBao tests. It answers the calls that the role and the
# guard make, from a state directory ($FAKE_STATE) and scenario variables, and it
# logs every argument list to $FAKE_STATE/bao-argv.log so a test can prove that no
# secret arrives as an argument. It follows OpenBao v2.5.2:
#   - `bao status` exits 0 unsealed and 2 sealed (command/status.go).
#   - `bao write PATH -` reads a JSON object from stdin, and `key=-` reads the
#     whole of stdin as the value (go-secure-stdlib kv-builder v0.1.2, builder.go).
#   - `bao write -format=json auth/userpass/login/NAME -` reads {"password": ...} from stdin.
#   - `bao write -format=json auth/approle/login -` reads {"role_id": ..., "secret_id": ...}
#     from stdin and accepts the pair of FAKE_APPROLE_ROLE_ID and FAKE_APPROLE_SECRET_ID.
#   - `bao operator unseal KEY` takes the key as its positional argument.
#   - `bao kv metadata get` prints "No value found at ..." and exits 2 for a
#     missing path, and exits 2 with "Error reading ..." for other failures
#     (command/kv_metadata_get.go).
#   - `bao token capabilities -format=json` prints a JSON list.
#   - `bao token create` takes -orphan, -policy, -ttl, -explicit-max-ttl, -use-limit,
#     -no-default-policy, -renewable and -format, as the CLI does (command/token_create.go),
#     and refuses any other flag. The caller needs a root token. Every new token is a record
#     in $FAKE_STATE/tokens/NAME.json with its parent, orphan flag, policies, creation time
#     and TTL in seconds. A token created without -orphan is revoked with its parent. The
#     file README.md in this directory lists what the fake does for these tokens (use
#     limits, expiry, accessors, Kubernetes login, the identity reads) and the variables
#     that it adds.
#   - `bao read -format=json sys/storage/raft/autopilot/state` prints the API
#     response: the state object, with snake_case keys (healthy, failure_tolerance,
#     leader, voters, servers), is under "data".
#   - `bao read -format=json sys/storage/raft/configuration` prints the API response:
#     data.config.servers is a list of {node_id, address, leader, voter}.
#   - `bao operator raft autopilot state -format=json` prints the same state with Go
#     field names (Healthy, FailureTolerance, Servers, NodeType, LastContact), as
#     OpenBao 2.5.2 does. The guard must not read this form, so a caller that does
#     fails the tests.
# Scenario variables (all optional):
#   FAKE_SEALED          space-separated pods that start sealed
#   FAKE_THRESHOLD       shares that unseal a pod (default 3)
#   FAKE_VALID_KEYS      space-separated accepted keys (default: any non-empty key)
#   FAKE_PASSWORD        accepted userpass password (default: pw)
#   FAKE_AUTOPILOT       healthy | unhealthy | stale | missing | delayed | denied | down |
#                        service_address (node 1 at the Service address)
#   FAKE_PEER_DOMAIN     what follows <pod>. in a Raft address (default
#                        openbao-internal.openbao.svc.cluster.local)
#   FAKE_RAFT_CONFIG     healthy | service_address | denied  (node 1's address in the
#                        Raft configuration; file raft-config in the state directory wins)
#   FAKE_PROMOTE_AFTER   with delayed: autopilot calls before the new voter is healthy
#   FAKE_CAPS_MISSING    space-separated paths on which the token has no capability
#   FAKE_CAPS_JSON       capability list for every other path (default ["read"])
#   FAKE_ESO_PKI_GRANT   capability list that a token named fake-eso* holds on pki/*
#                        (default ["deny"], a path without a grant)
#   FAKE_ESO_POLICY_FILE file whose text `bao read sys/policies/acl/eso-reader` returns as
#                        data.policy, for a token named fake-policy*
#   FAKE_ESO_ROLE_POLICIES  JSON list that `bao read auth/approle/role/external-secrets`
#                        returns as data.token_policies, for a token named fake-scheduler*
#                        (default ["eso-reader"])
#   FAKE_KV_MODE         ok | absent | denied | transport  (file $FAKE_STATE/kv-mode wins)
#   FAKE_KV_VERSION      version that `kv metadata get` reports (file kv-version wins)
#   FAKE_K8S_IGNORES_REVIEWER_FIELDS  set: an old mount, whose config read has no
#                        token_reviewer_jwt_set field
#   FAKE_K8S_WRITE_FAILS set: a write to auth/kubernetes/role/* fails
#   FAKE_POLICY_WRITER   set: a live token that is not root may read and write
#                        sys/policies/acl/* (the policy-reconciler grant)
#   FAKE_POLICY_WRITE_FAILS  set: `bao policy write NAME -` fails
#   FAKE_SEAL_ON_FAIL   set, with FAKE_POLICY_WRITE_FAILS: the failed policy write seals the pod, the
#                        pod then refuses every token call, and it rejects every unseal key
#   FAKE_GENROOT_AUTH   set: `bao operator generate-root` needs a live token, as on OpenBao
#                        2.6 and later. Unset, it ignores the token, as 2.5.2 does.
#   FAKE_GENROOT_THRESHOLD  shares that complete a root generation (default 3)
#   FAKE_ACTIVE_POD     pods that report is_self in `bao status` (unset: all do). Without FAKE_GENROOT_AUTH,
#                        generate-root on another pod fails with a 500, as on a 2.5.2 standby.
#   FAKE_OTP            the root generation OTP (default fake-otp); init and decode must carry it
#   FAKE_DECODE_FAILS   set: the decode of the generated root token fails
#   FAKE_DECODED_TOKEN  the token that the decode returns (default fake-root-genroot). A name
#                        that does not start with fake-root is a token without the root policy.
#   FAKE_GENROOT_LOSE_RESPONSE  set: the server records the last share, then the answer is lost
#   FAKE_REVOKE_FAILS   root, short, login or both (all kinds): `bao token revoke -self` fails
#                        for that kind of token. A short token is one that `token create`
#                        made (name fake-root-short-N); root is any other fake-root token.
#   FAKE_TOKEN_CREATE_FAILS  set: `bao token create` fails
#   FAKE_TOKEN_CREATE_LOST   set: `bao token create` creates and records the token, then the answer
#                        is lost: the call exits 2 with an error and prints no token
#   FAKE_REVOKE_FAIL_FIRST  number of revoke attempts per token that fail before one works
#   FAKE_OPS_POLICIES   comma list of the policies that ops-admin holds at the start
#   FAKE_POLICIES_WRITE_FAILS  set: a write to auth/userpass/users/NAME/policies fails
#   FAKE_PASSWORD_WRITE_FAILS  set: a write to auth/userpass/users/NAME fails
#   FAKE_TLS_MODEL      set: model TLS as the comment before tls_ok describes
#   FAKE_INITIALIZED    false: `bao status` reports a server that is not initialized
#   FAKE_STATUS_FAIL_COUNT  with FAKE_STATUS_FAILS: how many status calls fail (default all)
#   FAKE_STATUS_FAILS   text that `bao status` prints on stderr before it exits 1 (the
#                        word "garbage" prints non-JSON text on stdout instead)
#   FAKE_NOW            the fake clock, in epoch seconds (default 1800000000). Token creation
#                        times, expiry and the grace period of a revoker follow it.
#   FAKE_REVOKER_POLICY  the policy that lets a token list, look up and revoke by accessor
#                        (default token-revoker)
#   FAKE_VERIFIER_POLICY the policy that lets a token read the identity configuration
#                        (default identity-verifier)
# Kubernetes auth: the config and the roles are files under $state/k8s-auth. A token
# whose name starts with fake-root is a root token and may read and write
# auth/kubernetes/*; every other token gets 403 on a write. A token revoked with
# `bao token revoke -self` (file revoked-<token>) is refused everywhere. A config
# write rebuilds the config from its fields, as the mount does, and token_reviewer_jwt
# set to "" stores no token. A pem_keys value that does not parse fails after the
# permission check. A role write takes its fields as key=value arguments or, with `-`,
# as a JSON object on stdin, where a TTL is a number of seconds or a duration such as
# 5m. A root token reads sys/policies/acl/NAME: the policy exists when the file
# $state/policies/NAME does, and the read returns the text of that file.
# `bao policy write NAME -` stores its standard input in that file.
# Every call with the token it ran under goes to $FAKE_STATE/bao-calls.log as
# "TOKEN ARGS" (TOKEN is `none` without one), so a test sees which token made which call.
# Two outcomes go to the same log, in order, as "TOKEN =revoked" after a revoke that
# worked and "TOKEN =refused" when the server refuses a revoked token's lookup.
set -u
state="${FAKE_STATE:?FAKE_STATE is not set}"
pod="${FAKE_POD:-openbao-0}"
mkdir -p "$state"
printf '%s\n' "$*" >> "$state/bao-argv.log"
printf '%s %s\n' "${BAO_TOKEN:-none}" "$*" >> "$state/bao-calls.log"
# One log of every call in order, shared with the fake kubectl and the fake
# kubernetes.core modules, so a test can check what ran before what.
printf 'bao %s %s\n' "$pod" "$*" >> "$state/events.log"

pod_in() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
progress_file="$state/progress-$pod"
unsealed_file="$state/unsealed-$pod"
# A pod that the fake kubernetes.core.k8s deleted comes back sealed.
sealed_file="$state/sealed-$pod"
is_sealed() {
  [ -f "$unsealed_file" ] && return 1
  [ -f "$sealed_file" ] && return 0
  pod_in "$pod" "${FAKE_SEALED:-}" && return 0
  return 1
}
# The userpass user of the fake, kept in $state/userpass-user.json: its token_policies
# (FAKE_OPS_POLICIES at the start) and how many password writes it has had.
userpass_user() { # userpass_user show | write-user | set-policies  (the body on stdin)
  local body=""
  [ "$1" = show ] || body="$(cat)"
  FAKE_BODY="$body" python3 - "$state/userpass-user.json" "${FAKE_OPS_POLICIES:-app-admin-writer,app-runtime-writer}" "$1" <<'PY'
import json, os, sys
path, initial, op = sys.argv[1:4]
def as_list(value):
    return value if isinstance(value, list) else [p for p in str(value).split(",") if p]
user = json.load(open(path)) if os.path.exists(path) else {"token_policies": as_list(initial), "password_writes": 0}
if op in ("write-user", "set-policies"):
    body = json.loads(os.environ.get("FAKE_BODY") or "{}")
    if op == "write-user" and "password" in body:
        user["password_writes"] += 1
    if "token_policies" in body:
        user["token_policies"] = as_list(body["token_policies"])
    elif "policies" in body:
        user["token_policies"] = as_list(body["policies"])
    json.dump(user, open(path, "w"))
else:
    print(json.dumps(user))
PY
}
read_kv() { [ -f "$state/$1" ] && cat "$state/$1" || printf '%s' "$2"; }
count_call() { # count_call NAME -> prints the number of earlier calls, then records this one
  local n=0
  [ -f "$state/count-$1" ] && n="$(cat "$state/count-$1")"
  echo $((n + 1)) > "$state/count-$1"
  printf '%s' "$n"
}

# The fake clock and the token store. A token is a file $state/tokens/NAME.json:
# policies (with default), orphan, parent, created (epoch seconds), ttl (seconds, 0 for
# none), explicit_max_ttl, renewable, uses_left (null for no limit) and use_limit. A test
# may write such a file to seed a token, with an optional "accessor"; the accessor of a
# token without one is NAME-accessor. Every token that `token create` or a Kubernetes login
# makes is such a file, and a token with no file is a legacy token.
now="${FAKE_NOW:-1800000000}"
tokens_dir="$state/tokens"
token_store() { # token_store OP ARGS...: see the operations in the script below
  python3 - "$state" "$now" "$@" <<'PY'
import glob, json, os, sys
state, now, op, args = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4:]
tokens = os.path.join(state, "tokens")

def seconds(text):
    units = {"s": 1, "m": 60, "h": 3600}
    return int(text[:-1]) * units[text[-1]] if text and text[-1] in units else int(text or 0)

def load(name):
    path = os.path.join(tokens, name + ".json")
    if os.path.exists(path):
        return json.load(open(path))
    return None

def is_orphan(record):   # without the field, a token with no parent is an orphan
    value = record.get("orphan")
    return (not record.get("parent")) if value is None else bool(value)

def spent(record):   # a use limit that is used up; null or missing is no limit
    return record.get("uses_left") is not None and record["uses_left"] <= 0

def lapsed(record):
    # A token ends with the shorter of its TTL and explicit maximum TTL (0 or missing is none).
    # A negative lifetime is not a state of OpenBao, and a token made after the time of the
    # call does not exist yet.
    created = record.get("created")
    created = now if created is None else int(created)
    limits = [int(record.get(field) or 0) for field in ("ttl", "explicit_max_ttl")]
    if created > now or min(limits) < 0:
        return True
    limit = min([value for value in limits if value > 0], default=0)
    return bool(limit) and now >= created + limit

def expired(record):
    # A token also ends with every ancestor it was made without -orphan, however deep the
    # chain. A parent without a record is a legacy token (its name starts with fake-) and
    # ends the chain. A cycle, or any other missing parent, fails closed.
    if lapsed(record):
        return True
    seen, current = set(), record
    while current.get("parent") and not is_orphan(current):
        name = current["parent"]
        if name in seen:
            return True
        seen.add(name)
        current = load(name)
        if current is None:
            return not name.startswith("fake-")
        if lapsed(current):
            return True
    return False

def accessor_of(name, record):
    return record.get("accessor") or name + "-accessor"

def live_names():
    names = [os.path.basename(p)[:-5] for p in glob.glob(os.path.join(tokens, "*.json"))]
    return sorted(n for n in set(names) if not os.path.exists(os.path.join(state, "revoked-" + n))
                  and not expired(load(n)) and not spent(load(n)))

def find(accessor):
    for name in live_names():
        if accessor_of(name, load(name)) == accessor:
            return name
    return None

def describe(name, record, show_id):
    created, ttl = record.get("created", now), int(record.get("ttl") or 0)
    return {"accessor": accessor_of(name, record), "id": name if show_id else "", "policies": record["policies"],
            "orphan": is_orphan(record), "renewable": bool(record.get("renewable", True)),
            "creation_time": created, "creation_ttl": ttl, "ttl": max(created + ttl - now, 0) if ttl else 0,
            "explicit_max_ttl": int(record.get("explicit_max_ttl") or 0),
            "num_uses": record.get("uses_left") or 0, "path": "auth/token/create", "display_name": "token"}

if op == "limited":   # exit 0 for a token that has a use limit
    record = load(args[0])
    sys.exit(0 if record and record.get("uses_left") is not None else 1)
elif op == "live":    # exit 1 for a token whose lifetime is over
    record = load(args[0])
    sys.exit(1 if record and expired(record) else 0)
elif op == "use":     # spend one use; print "final" when that was the last one
    path = os.path.join(tokens, args[0] + ".json")
    record = json.load(open(path))
    if spent(record):   # no use is left: the token is gone before the call is dispatched
        open(os.path.join(state, "revoked-" + args[0]), "w").close()
    elif record.get("uses_left") is not None and not expired(record):
        record["uses_left"] -= 1
        json.dump(record, open(path, "w"))
        print("final" if record["uses_left"] <= 0 else "")
elif op == "policies":
    print("\n".join(load(args[0])["policies"]))
elif op == "accessors":
    print("\n".join(accessor_of(n, load(n)) for n in live_names()))
elif op == "name-of":
    name = find(args[0])
    print(name or "", end="")
    sys.exit(0 if name else 1)
elif op == "lookup":  # by accessor
    name = find(args[0])
    if not name:
        sys.exit(1)
    print(json.dumps({"data": describe(name, load(name), False)}))
elif op == "lookup-self":
    print(json.dumps({"data": describe(args[0], load(args[0]), True)}))
elif op == "create":  # NAME PARENT ORPHAN TTL EXPLICIT_MAX USE_LIMIT RENEWABLE NO_DEFAULT POLICY...
    name, parent, orphan, ttl, explicit_max, use_limit, renewable, no_default = args[:8]
    ttl, explicit_max = seconds(ttl), seconds(explicit_max)
    # The policies are lower case, without duplicates and in order. The root policy stands
    # alone. The default policy is added, except to root and with -no-default-policy.
    wanted = {p.strip().lower() for p in args[8:] if p.strip()}
    root = "root" in wanted
    if no_default == "as-given":   # a login token comes from the auth method, not the token store
        policies = ["default"] + [p for p in args[8:] if p != "default"]
    elif root:
        policies = ["root"]
    else:
        policies = sorted(wanted if no_default == "true" else wanted | {"default"})
    month = 32 * 24 * 3600   # the default and the longest lifetime of a token
    # A use limit of 0 is OpenBao's value for unlimited: no limit is kept as null.
    if not ttl and not explicit_max:
        ttl = 0 if root else month   # a root token without a TTL never expires
    elif explicit_max and (not ttl or ttl > explicit_max):
        ttl = explicit_max
    ttl = min(ttl, month)
    if not ttl:
        renewable = "false"
    record = {"parent": parent, "orphan": orphan == "true", "policies": policies, "ttl": ttl,
              "explicit_max_ttl": explicit_max, "renewable": renewable == "true", "created": now,
              "uses_left": int(use_limit or 0) or None, "use_limit": int(use_limit or 0)}
    os.makedirs(tokens, exist_ok=True)
    json.dump(record, open(os.path.join(tokens, name + ".json"), "w"))
    print(json.dumps({"auth": {"client_token": name, "accessor": name + "-accessor", "policies": policies,
                               "token_policies": policies, "lease_duration": ttl, "renewable": record["renewable"],
                               "orphan": record["orphan"], "num_uses": record["use_limit"]}}))
PY
}
# The Kubernetes login check: prints "TTL MAX_TTL POLICY..." for a role that exists. A JWT of
# the form fake-sa:NAMESPACE:NAME must match the role's bound ServiceAccount; any other
# JWT that is not empty is accepted without a binding check.
k8s_login_role() { # k8s_login_role ROLE JWT
  python3 - "$k8s_auth_dir/role-$1.json" "$2" "$1" <<'PY'
import json, os, sys
path, jwt, name = sys.argv[1:4]
if not os.path.exists(path):
    sys.exit('Error making API request.\n\nCode: 400. Errors:\n\n* invalid role name "%s"' % name)
role = json.load(open(path))
if not jwt:
    sys.exit("Error making API request.\n\nCode: 400. Errors:\n\n* missing client token")
if jwt.startswith("fake-sa:"):
    _, namespace, account = jwt.split(":", 2)
    names = role.get("bound_service_account_names", [])
    namespaces = role.get("bound_service_account_namespaces", [])
    if (account not in names and "*" not in names) or (namespace not in namespaces and "*" not in namespaces):
        sys.exit("Error making API request.\n\nCode: 403. Errors:\n\n* permission denied")
print(role.get("token_ttl", 0), role.get("token_max_ttl", 0), *[p for p in role.get("token_policies", []) if p])
PY
}
# The read-only configuration that the identity verifier reads, from $state/identity.json:
# auth_methods (the response of sys/auth, by mount path), userpass_users, approle_roles,
# token_roles, entities and groups (each an object of name or ID to its fields).
identity_fixture() { # identity_fixture PREFIX [KEY]: the keys, or one entry, as `bao` prints them
  python3 - "$state/identity.json" "$@" <<'PY'
import json, os, sys
path, prefix, key = sys.argv[1], sys.argv[2], (sys.argv[3] if len(sys.argv) > 3 else None)
sections = {"auth/userpass/users": "userpass_users", "auth/approle/role": "approle_roles",
            "auth/token/roles": "token_roles", "identity/entity/id": "entities", "identity/group/id": "groups"}
fixture = json.load(open(path)) if os.path.exists(path) else {}
entries = fixture.get(sections[prefix], {})
if key is None:
    # Without a fixture file the only userpass user is ops-admin, whose record is userpass-user.json.
    legacy = {"ops-admin": 1} if prefix == "auth/userpass/users" and not os.path.exists(path) else {}
    print("\n".join(sorted(entries or legacy)))
elif key in entries:
    print(json.dumps({"data": dict(entries[key], **({"id": key} if prefix.startswith("identity/") else {}))}))
else:
    sys.exit("No value found at %s/%s" % (prefix, key))
PY
}
print_keys() { # print_keys PATH KEYS: the answer of `bao list`, as JSON or as the table; none: exit 2
  if [ -z "$2" ]; then
    if [ -n "$json_out" ]; then echo '{}'; else echo "No value found at $1" >&2; fi
    exit 2
  fi
  if [ -n "$json_out" ]; then
    printf '%s\n' "$2" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().split()))'
  else
    printf 'Keys\n----\n%s\n' "$2"
  fi
}
field() { # field NAME ARGS...: the value of the NAME=value argument
  local name="$1" arg
  shift
  for arg in "$@"; do case "$arg" in "$name="*) printf '%s' "${arg#"$name="}"; return 0 ;; esac; done
  return 0
}

# TLS (FAKE_TLS_MODEL set): the server answers over TLS with the certificate in
# $state/served-POD, and the client verifies it against the file that BAO_CACERT names
# (the pod's own environment, state file pod-cacert-POD, when the call sets none). The
# file holds what the kubelet projects from k8s/Secret-openbao-tls.json. A certificate
# verifies against a CA file that holds it, or the CA that the fake kubernetes.core wrote
# into its text ("|issuer=" followed by the CA's identity, its text up to a "#"). A
# failure prints the Go error and
# exits 1 with nothing on stdout, as bao does.
projected_text() {
  python3 -c 'import base64,json,sys; print(base64.b64decode(json.load(open(sys.argv[1]))["data"].get(sys.argv[2], "")).decode(), end="")' "$state/k8s/Secret-openbao-tls.json" "$1"
}
tls_ok() {
  [ -n "${FAKE_TLS_MODEL:-}" ] || return 0
  local served cafile bundle
  served="$(cat "$state/served-$pod" 2>/dev/null || projected_text tls.crt)"
  cafile="${BAO_CACERT:-$(cat "$state/pod-cacert-$pod" 2>/dev/null || echo /openbao/config/tls/ca.crt)}"
  bundle="$(projected_text "$(basename "$cafile")")"
  [ "$served" = "$bundle" ] || [ "${served%|issuer=${bundle%%#*}}" != "$served" ]
}
if [ "${1:-}" = status ] && [ -n "${FAKE_STATUS_FAILS:-}" ] && [ "$(count_call statusfail)" -lt "${FAKE_STATUS_FAIL_COUNT:-1000000}" ]; then
  case "$FAKE_STATUS_FAILS" in
    garbage) echo 'not json at all'; exit 1 ;;
    *) echo "$FAKE_STATUS_FAILS" >&2; exit 1 ;;
  esac
fi
if [ "${1:-}" = status ] && ! tls_ok; then
  echo 'Error checking seal status: Get "https://127.0.0.1:8200/v1/sys/seal-status": tls: failed to verify certificate: x509: certificate signed by unknown authority' >&2
  exit 1
fi

# Only commands that the real CLI has: the command registry of v2.5.2 (command/commands.go)
# and of v2.7.2 (internal/command/commands.go). A command that a play invented fails here
# instead of passing against the fake.
case "${1:-} ${2:-}" in
  "status "*|"write "*|"read "*|"list "*|"kv metadata"|"policy write"|"operator init"|"operator unseal"|"operator generate-root"|"operator raft"|"token capabilities"|"token create"|"token lookup"|"token revoke"|"auth enable"|"secrets enable") ;;
  *) echo "bao: unknown command: $*" >&2; exit 127 ;;
esac

# Revoke NAME and every token below it that was made without -orphan: the children, their
# children, and so on. An orphan keeps its own tree.
revoke_children() { # revoke_children NAME
  local record child
  for record in "$tokens_dir"/*.json; do
    [ -f "$record" ] || continue
    child="$(basename "$record" .json)"
    [ ! -f "$state/revoked-$child" ] || continue
    if python3 - "$record" "$1" <<'PY'
import json, sys
record = json.load(open(sys.argv[1]))
orphan = record.get("orphan")
orphan = not record.get("parent") if orphan is None else bool(orphan)
sys.exit(0 if record.get("parent") == sys.argv[2] and not orphan else 1)
PY
    then
      touch "$state/revoked-$child"
      revoke_children "$child"
    fi
